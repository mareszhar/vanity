{
  "name": "vanity",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Maintainer workspace for @mszr/vanity",
  "scripts": {
    "postinstall": "tsx scripts/install-git-hooks.ts --optional",
    "git:hooks:install": "tsx scripts/install-git-hooks.ts",
    "upi": "tsx scripts/update-dependencies.ts",
    "prep": "turbo run prep",
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "lint:staged": "lint-staged",
    "lint:fix": "eslint . --fix",
    "clean:validation": "tsx scripts/clean-validation.ts",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "pnpm run workspace:typecheck && turbo run typecheck",
    "typecheck:validation": "pnpm run workspace:typecheck && turbo run typecheck --force",
    "workspace:typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "turbo run test --filter=@mszr/vanity",
    "test:maintainer": "node --import tsx --test scripts/update-dependencies.test.ts scripts/package-contract.test.ts",
    "audit": "tsx scripts/audit.ts",
    "deps:check": "pnpm install --frozen-lockfile",
    "check:fast": "pnpm run lint && pnpm run workspace:typecheck && pnpm run sdk:typecheck && pnpm run sdk:test:fast",
    "check": "pnpm run deps:check && pnpm run clean:validation && pnpm run lint && pnpm run typecheck:validation && pnpm run docs:examples && pnpm run readme:check && pnpm run test && pnpm run test:maintainer && pnpm run audit && pnpm run bench:fixtures:check",
    "validate": "pnpm run check && pnpm run canary:validate && pnpm run demo:e2e",
    "val": "pnpm run validate",
    "sdk:dev": "turbo run dev --filter=@mszr/vanity",
    "sdk:build": "turbo run build --filter=@mszr/vanity",
    "sdk:typecheck": "turbo run typecheck --filter=@mszr/vanity",
    "sdk:test": "turbo run test --filter=@mszr/vanity",
    "sdk:test:fast": "pnpm --dir sdk run test:fast",
    "sdk:test:dx": "pnpm --dir sdk run test:dx",
    "sdk:test:types": "pnpm --dir sdk run test:types",
    "sdk:test:watch": "pnpm --dir sdk run test:watch",
    "bench:generate": "tsx scripts/generate-benchmarks.ts",
    "bench:fixtures:check": "tsx scripts/generate-benchmarks.ts --check",
    "bench:resolution": "tsx scripts/benchmark-resolution.ts",
    "bench:baseline": "pnpm run sdk:build && pnpm run bench:fixtures:check && tsx scripts/benchmark.ts",
    "docs:examples": "tsx scripts/check-doc-examples.ts",
    "readme:sync": "tsx scripts/sync-package-readme.ts",
    "readme:check": "tsx scripts/sync-package-readme.ts --check",
    "css:optimizer:check": "tsx scripts/check-built-css.ts",
    "demo:main": "turbo run dev --filter=demo-main",
    "demo:main:prep": "turbo run prep --filter=demo-main",
    "demo:comparisons": "turbo run dev --filter=demo-comparisons",
    "demo:comparisons:prep": "turbo run prep --filter=demo-comparisons",
    "demo:typecheck": "pnpm run clean:validation && turbo run typecheck --force --filter=demo-main --filter=demo-comparisons",
    "demo:build": "turbo run build --concurrency=3 --filter=demo-main --filter=demo-comparisons",
    "demo:e2e:prod": "playwright test",
    "demo:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "demo:dev:lifecycle": "tsx scripts/dev-lifecycle.ts",
    "demo:e2e": "pnpm run demo:build && pnpm run css:optimizer:check && pnpm run demo:e2e:prod && pnpm run demo:e2e:dev && pnpm run demo:dev:lifecycle",
    "canary:browser": "playwright test --config playwright.canary.config.ts",
    "canary:validate": "pnpm run sdk:build && pnpm --dir sandbox/canary run typecheck && tsx sandbox/canary/src/tool.ts && pnpm --dir sandbox/canary run build && pnpm run canary:browser && pnpm --dir sandbox/canary run build:ssr",
    "fresh:smoke": "tsx scripts/fresh-smoke.ts",
    "publish:sdk:dry-run": "tsx scripts/publish-sdk.ts dry-run",
    "publish:sdk:patch": "tsx scripts/publish-sdk.ts patch",
    "publish:sdk:minor": "tsx scripts/publish-sdk.ts minor",
    "publish:sdk:major": "tsx scripts/publish-sdk.ts major"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@clack/prompts": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "jiti": "catalog:",
    "lint-staged": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,cts,mts,jsx,tsx,vue,json,jsonc,yaml,yml,md}": "eslint --cache --cache-location .cache/eslint --no-warn-ignored --max-warnings=0"
  }
}
