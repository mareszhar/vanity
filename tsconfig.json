{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./.cache/typescript/workspace.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "*.config.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
