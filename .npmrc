registry=https://registry.npmjs.org/

# A git hook has no TTY, so pnpm's default pre-run dependency check can abort a
# commit when it tries to auto-install (e.g. after a release bumps a manifest).
# Keep runs clean and installs explicit; deps integrity is gated by the
# `pnpm install --frozen-lockfile` step in `check` and in CI, which fails only
# on real lockfile/manifest drift — not on benign version bumps.
verify-deps-before-run=false
